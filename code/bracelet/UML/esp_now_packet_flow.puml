@startuml
title Bracelet / Station ESP-NOW Packet Flow

participant "Bracelet ESP32-C3" as Bracelet
participant "Station ESP32" as Station
participant "Home WiFi router" as Router

Station -> Router : associate for NTP, Supabase and remote audio
Station -> Station : initialize ESP-NOW on the router channel
Bracelet -> Bracelet : scan channels 1 through 13
Station -> Bracelet : broadcast station_control protocol v5

alt first valid exchange
  Bracelet -> Bracelet : persist station MAC in NVS
  Bracelet -> Station : immediate broadcast bracelet_status
  Station -> Station : persist bracelet MAC in NVS
else already paired
  Bracelet -> Bracelet : reject foreign station MACs
  Station -> Station : reject foreign bracelet MACs
end

Bracelet -> Bracelet : lock onto the station channel for 15 seconds

loop idle / armed
  Station -> Bracelet : control every 5 seconds
  Bracelet -> Station : status every 10 seconds
end

loop ringing / validating_activity
  Station -> Bracelet : control every 700 ms
  Bracelet -> Station : status every 200 ms
  Bracelet -> Station : qualifying movement immediately
end

Station -> Station : validate retained event and age
Station -> Station : mute for remaining part of original 10 seconds
Station -> Bracelet : vibration request with new id
Bracelet -> Bracelet : start vibration pulse
Bracelet -> Station : immediate status with vibration_ack_id

alt no valid control for 15 seconds
  Bracelet -> Bracelet : resume channel scanning every 300 ms
else station found
  Bracelet -> Bracelet : keep the discovered channel locked
end

note right of Station
  Packet loss is handled by retained events,
  identifiers, retransmission and acknowledgements.
  The station remains the alarm authority.
end note

note bottom
  Pairing survives reboot. Replacing either device requires
  erasing NVS/flash before reflashing both intended peers.
end note

@enduml
