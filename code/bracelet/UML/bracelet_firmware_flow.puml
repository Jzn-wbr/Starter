@startuml
title Bracelet Firmware Flow

start
:Configure vibration motor, battery ADC and BMI270;
:Load the paired station MAC from NVS;
:Start WiFi STA mode without joining the router;
:Disable radio sleep and initialize ESP-NOW;
:Register an ESP-NOW broadcast peer;

repeat
  :Sample battery once per second;

  if (valid ESP-NOW station_control received?) then (yes)
    if (station not paired?) then (yes)
      :Persist the first valid station MAC in NVS;
    else (no)
      :Reject controls from any other MAC;
    endif
    :Store station state, acknowledgements and vibration request;
    :Lock onto the current radio channel for 15 seconds;
  else (no)
    if (no valid control for 15 seconds?) then (yes)
      :Scan WiFi channels 1 through 13 every 300 ms;
      :Send a status packet on each channel;
    endif
  endif

  if (BMI270 ready and motor settled?) then (yes)
    :Read accelerometer and gyroscope at 50 Hz;
    :Accumulate noise-filtered energy in 200 ms windows;
  else (no)
    :Exclude vibration noise or retry BMI270;
  endif

  if (completed window reaches threshold?) then (yes)
    :Create a protocol v6 movement event;
    :Retain for at most 10 seconds until acknowledged;
    :Send bracelet_status immediately over ESP-NOW;
  endif

  if (vibration requested?) then (yes)
    :Pulse motor 500 ms every 4 seconds;
    :Acknowledge id only after motor starts;
    :Send acknowledgement immediately;
  endif

  if (alarm active?) then (yes)
    :Send protocol v6 status every 200 ms;
  else (no)
    :Send protocol v6 status every 10 seconds;
  endif
repeat while (device powered)

@enduml
