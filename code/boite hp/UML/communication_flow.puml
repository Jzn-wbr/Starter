@startuml
title Bedside station v1 communication flow

participant "Station firmware" as Station
participant "Configured Wi-Fi networks" as Wifi
database "Supabase REST" as Supabase
participant "NTP" as Ntp
participant "ESP-NOW bracelet" as Bracelet
participant "Audio output\nPCM5102A/PAM8403" as Audio

Station -> Wifi : try primary Wi-Fi network
alt primary unavailable after 10 seconds
  Station -> Wifi : try fallback Wi-Fi network
  note right
    If neither network connects, retry the cycle
    after the Wi-Fi retry delay.
  end note
end
Station -> Ntp : synchronize local time once Wi-Fi is connected
Station -> Supabase : GET alarm_plan main
Station -> Supabase : GET alarm_audio_selection main
alt selected track
  Station -> Supabase : GET music_tracks selected_track_id\npublic_url from stored track row
end
Station -> Station : cache valid combined config
alt alarm revision already completed or 15-minute window expired
  Station -> Supabase : publish station_state=idle
else pending alarm
  Station -> Supabase : publish station_state=armed
end
Station -> Supabase : publish station_status\nwith station_battery_voltage from GPIO34
note right
  active_alarm_revision is null until a valid
  alarm_plan revision has been loaded.
end note

loop while armed/ringing
  Bracelet -> Station : protocol v2 bracelet_status\nwith energy, retained event and vibration ack
  Station -> Bracelet : protocol v2 station_control\nwith event ack and vibration request id\nat 700 ms cadence and on state changes
end

loop every 10 seconds while connected
  Station -> Supabase : refresh alarm_plan and alarm_audio_selection
  Station -> Supabase : publish station_status with minimal response\nwith station_battery_voltage from GPIO34
  Station -> Supabase : publish bracelet_status with minimal response\nwithout high-rate energy graph streaming
end
note right
  During active remote audio streaming, periodic
  Supabase refresh/status writes and transition
  status writes are deferred so
  audio.loop() can keep the enlarged stream
  buffer filled.
end note

alt alarm time within 15-minute activity window
  Station -> Audio : start selected stream or local fallback
  Station -> Audio : prime remote stream briefly\nbefore requesting bracelet vibration
  alt valid retained event reaches threshold 1,333,333
    Station -> Station : calculate event age from bracelet uptime
    Station -> Audio : mute XSMT for 10 s minus event age\nkeep stream/fallback running
    Station -> Supabase : station_state=validating_activity
  else bracelet energy below threshold
    Station -> Audio : unmute XSMT GPIO26\ncontinue running audio
  end
  alt mute timer active
    Station -> Audio : stay muted
  else mute timer expires
    Station -> Bracelet : request vibration with a new id\nwhile XSMT remains muted
    alt matching vibration acknowledgement arrives
      Station -> Station : start 3 s warning plus 500 ms guard
    else no acknowledgement for 3 s
      Station -> Audio : resume alarm conservatively
    end
    alt bracelet energy reaches threshold during warning
      Station -> Audio : keep muted for a new 10 s window
    else no new threshold event
    Station -> Audio : resume alarm output
    Station -> Supabase : station_state=ringing
    end
  end
  alt bracelet packets missing for more than 3 seconds
    Station -> Audio : honor an existing confirmed mute deadline\notherwise keep alarm audible
    Station -> Supabase : publish problem_code=bracelet_missing
  else bracelet communication restored
    Station -> Station : resume movement detection automatically
  end
end

Station -> Station : 15-minute activity window ends
Station -> Audio : stop stream/fallback alarm audio
Station -> Supabase : station_state=stopped

@enduml
