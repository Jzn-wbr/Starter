@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

actor "User" as User

rectangle "Wake-up PWA" {
  usecase "Upload wake-up music" as UploadMusic
  usecase "Browse music library" as BrowseMusic
  usecase "Select wake-up track" as SelectTrack
  usecase "Select local fallback sound" as SelectFallback
  usecase "Configure tomorrow alarm" as ConfigureAlarm
  usecase "View station status" as ViewStationStatus
  usecase "View bracelet status" as ViewBraceletStatus
  usecase "View blocking problems" as ViewProblems
}

rectangle "Supabase" {
  usecase "Store audio file" as StoreAudio
  usecase "Store music metadata" as StoreMusicMetadata
  usecase "Store alarm_plan" as StoreAlarmPlan
  usecase "Store alarm_audio_selection" as StoreAlarmAudio
  usecase "Expose station_status" as ExposeStationStatus
  usecase "Expose bracelet_status" as ExposeBraceletStatus
}

User --> UploadMusic
User --> BrowseMusic
User --> SelectTrack
User --> SelectFallback
User --> ConfigureAlarm
User --> ViewStationStatus
User --> ViewBraceletStatus
User --> ViewProblems

UploadMusic --> StoreAudio
UploadMusic --> StoreMusicMetadata
BrowseMusic --> StoreMusicMetadata
SelectTrack --> StoreAlarmAudio
SelectFallback --> StoreAlarmAudio
ConfigureAlarm --> StoreAlarmPlan
ConfigureAlarm --> StoreAlarmAudio
ViewStationStatus --> ExposeStationStatus
ViewBraceletStatus --> ExposeBraceletStatus
ViewProblems --> ExposeStationStatus
ViewProblems --> ExposeBraceletStatus

note bottom of "Wake-up PWA"
  The PWA configures the system through Supabase.
  It does not trigger or stop the alarm directly.
  The app only proposes alarm slots in the next 20 hours.
  Status polling runs only while the page is visible.
end note

@enduml
